@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-dark">
        <div>
            <h1 class="fw-bold text-uppercase tracking-wide fs-3 mb-0 text-dark">Loans Directory</h1>
            <p class="text-muted small mb-0">@Model.Count total record(s) · Newest First</p>
        </div>
        <a asp-action="Borrow" class="btn btn-dark rounded-0 px-4 text-uppercase fw-semibold shadow-sm">
            + Borrow Book
        </a>
    </div>

    <!-- Monochrome Table Layout -->
    <div class="table-responsive border border-dark bg-white shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-black text-white text-uppercase fs-7">
                <tr>
                    <th class="py-3 px-3">Member</th>
                    <th class="py-3 px-3">Book</th>
                    <th class="py-3 px-3">Loaned</th>
                    <th class="py-3 px-3">Due</th>
                    <th class="py-3 px-3">Status</th>
                    <th class="py-3 px-3 text-end" style="width: 8rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr class="border-top border-light">
                        <td class="fw-bold text-dark px-3">@loan.MemberName</td>
                        <td class="text-secondary px-3">@loan.BookTitle</td>
                        <td class="text-secondary px-3">@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                        <td class="text-secondary px-3">@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                        <td class="px-3">
                            <span class="badge rounded-0 px-2 py-1 text-uppercase border @(loan.Status == "Overdue" ? "bg-dark text-white border-dark" : loan.Status == "Out" ? "bg-light text-dark border-dark" : "bg-light text-muted border-secondary")">
                                @loan.Status
                            </span>
                        </td>
                        <td class="text-end px-3">
                            @if (loan.ReturnedOn == null)
                            {
                                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-dark rounded-0 text-uppercase px-2 py-1 fs-8">Return</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>