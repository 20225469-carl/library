@model BorrowForm
@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="container my-4" style="max-width: 40rem;">
    <!-- Header -->
    <div class="pb-3 mb-4 border-bottom border-dark">
        <h1 class="fw-bold text-uppercase tracking-wide fs-3 mb-0 text-dark">Borrow a Book</h1>
        <p class="text-muted small mb-0">Create a new loan record for a member</p>
    </div>

    <!-- Form Card -->
    <div class="card rounded-0 border-dark shadow-sm bg-white">
        <div class="card-body p-4">
            <form asp-action="Borrow" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 border-dark mb-4"></div>

                <div class="mb-3">
                    <label asp-for="MemberId" class="form-label text-uppercase fw-semibold fs-7 text-dark">Member</label>
                    <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select rounded-0 border-dark">
                        <option value="">(Select Member)</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BookId" class="form-label text-uppercase fw-semibold fs-7 text-dark">Book</label>
                    <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select rounded-0 border-dark">
                        <option value="">(Select Book)</option>
                    </select>
                    <span asp-validation-for="BookId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DaysAllowed" class="form-label text-uppercase fw-semibold fs-7 text-dark">Days Allowed</label>
                    <input asp-for="DaysAllowed" class="form-control rounded-0 border-dark" />
                    <span asp-validation-for="DaysAllowed" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-dark rounded-0 text-uppercase fw-semibold px-4">Cancel</a>
                    <button type="submit" class="btn btn-dark rounded-0 text-uppercase fw-semibold px-4">Borrow</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}