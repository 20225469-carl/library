@model List<Member>
@{
    ViewData["Title"] = "Members Directory";
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-dark">
        <div>
            <h1 class="fw-bold text-uppercase tracking-wide fs-3 mb-0 text-dark">Members Directory</h1>
            <p class="text-muted small mb-0">Total Registered: @Model.Count</p>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-0 px-4 text-uppercase fw-semibold shadow-sm">
            + Add Member
        </a>
    </div>

    <!-- Monochrome Table Layout -->
    <div class="table-responsive border border-dark bg-white shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-black text-white text-uppercase fs-7">
                <tr>
                    <th class="py-3 px-3 text-end" style="width: 4rem;">#</th>
                    <th class="py-3 px-3">Full Name</th>
                    <th class="py-3 px-3">Email</th>
                    <th class="py-3 px-3">Phone</th>
                    <th class="py-3 px-3">Join Date</th>
                    <th class="py-3 px-3">Type</th>
                    <th class="py-3 px-3 text-end" style="width: 12rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="border-top border-light">
                        <td class="text-end text-muted fw-mono px-3">@m.MemberId</td>
                        <td class="fw-bold text-dark px-3">@m.FullName</td>
                        <td class="text-secondary px-3">@(m.Email ?? "—")</td>
                        <td class="text-secondary px-3">@(m.PhoneNumber ?? "—")</td>
                        <td class="text-secondary px-3">@m.JoinDate.ToString("yyyy-MM-dd")</td>
                        <td class="px-3">
                            <span class="badge bg-light text-dark border border-dark rounded-0 px-2 py-1">@m.MemberType</span>
                        </td>
                        <td class="text-end px-3">
                            <a asp-action="Edit" asp-route-id="@m.MemberId" class="btn btn-sm btn-outline-dark rounded-0 text-uppercase px-2 py-1 fs-8">Edit</a>
                            <a asp-action="Delete" asp-route-id="@m.MemberId" class="btn btn-sm btn-dark rounded-0 text-uppercase px-2 py-1 fs-8 ms-1">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>