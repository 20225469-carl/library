@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members registered</p>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Join Date</th>
            <th>Type</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td class="text-end">@m.MemberId</td>
                <td>@m.FullName</td>
                <td>@(m.Email ?? "—")</td>
                <td>@m.JoinDate.ToString("yyyy-MM-dd")</td>
                <td>@m.MemberType</td>
                <td class="text-end"></td>
            </tr>
        }
    </tbody>
</table>