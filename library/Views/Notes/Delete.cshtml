@model Note
@{
    ViewData["Title"] = "Delete Note";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="border border-dark p-4 bg-white shadow-sm">
        <h2 class="fw-bold text-uppercase fs-4 mb-3 pb-2 border-bottom border-dark text-dark">Delete Note</h2>

        <p class="text-secondary">Are you sure you want to delete this note?</p>

        <dl class="row mb-3">
            <dt class="col-4 text-uppercase fs-7 text-dark">Title</dt>
            <dd class="col-8 text-dark fw-bold">@Model.Title</dd>

            <dt class="col-4 text-uppercase fs-7 text-dark">Body</dt>
            <dd class="col-8 text-secondary">@(Model.Body ?? "—")</dd>

            <dt class="col-4 text-uppercase fs-7 text-dark">Created On</dt>
            <dd class="col-8 text-secondary">@Model.CreatedOn.ToString("yyyy-MM-dd")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="pt-3 border-top border-dark d-flex justify-content-between align-items-center">
            <input type="hidden" asp-for="NoteId" />
            <a asp-action="Index" class="btn btn-outline-dark rounded-0 text-uppercase px-4 fw-semibold">Cancel</a>
            <button type="submit" class="btn btn-dark rounded-0 text-uppercase px-5 fw-semibold">Delete</button>
        </form>
    </div>
</div>