@model List<Note>
@{
    ViewData["Title"] = "Notepad";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom border-dark">
        <div>
            <h1 class="fw-bold text-uppercase fs-3 mb-0 text-dark">Library Notepad</h1>
            <p class="text-secondary mb-0">@Model.Count notes in the system</p>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-0 px-4 text-uppercase fw-semibold">+ New Note</a>
    </div>

    <div class="table-responsive border border-dark bg-white shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-black text-white text-uppercase fs-7">
                <tr>
                    <th class="py-3 px-3" style="width: 5rem;">#</th>
                    <th class="py-3 px-3">Title</th>
                    <th class="py-3 px-3">Body</th>
                    <th class="py-3 px-3">Created On</th>
                    <th class="py-3 px-3 text-end" style="width: 12rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr class="border-top border-light">
                        <td class="text-secondary px-3">@n.NoteId</td>
                        <td class="fw-bold text-dark px-3">@n.Title</td>
                        <td class="text-secondary px-3">@(n.Body ?? "—")</td>
                        <td class="text-secondary px-3">@n.CreatedOn.ToString("yyyy-MM-dd")</td>
                        <td class="text-end px-3">
                            <a asp-action="Edit" asp-route-id="@n.NoteId" class="btn btn-sm btn-outline-dark rounded-0 text-uppercase px-2 py-1 fs-8">Edit</a>
                            <a asp-action="Delete" asp-route-id="@n.NoteId" class="btn btn-sm btn-dark rounded-0 text-uppercase px-2 py-1 fs-8 ms-1">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>