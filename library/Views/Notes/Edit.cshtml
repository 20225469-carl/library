@model Note
@{
    ViewData["Title"] = "Edit Note";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="border border-dark p-4 bg-white shadow-sm">
        <h2 class="fw-bold text-uppercase fs-4 mb-3 pb-2 border-bottom border-dark text-dark">Edit Note</h2>

        <form asp-action="Edit" method="post" class="mt-3">
            <input type="hidden" asp-for="NoteId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label text-uppercase fw-semibold fs-7 text-dark">Title</label>
                <input asp-for="Title" class="form-control rounded-0 border-dark shadow-none" />
                <span asp-validation-for="Title" class="text-danger fs-8"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Body" class="form-label text-uppercase fw-semibold fs-7 text-dark">Body</label>
                <textarea asp-for="Body" class="form-control rounded-0 border-dark shadow-none" rows="4"></textarea>
                <span asp-validation-for="Body" class="text-danger fs-8"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark">
                <a asp-action="Index" class="btn btn-outline-dark rounded-0 text-uppercase px-4 fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-dark rounded-0 text-uppercase px-5 fw-semibold">Update Note</button>
            </div>
        </form>
    </div>
</div>